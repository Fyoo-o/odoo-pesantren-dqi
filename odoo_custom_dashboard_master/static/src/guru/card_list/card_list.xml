<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="owl.GuruList" owl="1">
        <div class="row w-100 h-100 m-0" style="font-size: 12px; line-height: 1.5;">
            <div class="col-lg-12 p-0">
                <div class="card shadow-sm border-0 rounded-0">
                    <div class="card-header d-flex justify-content-between">
                        <h3 class="card-title mb-0">Penilaian Akhir Guru</h3>
                         <select class="form-select form-select-sm" style="width: auto;" t-on-change="onViewChange" t-model="state.viewMode">
                            <option value="current">Data Guru Saat Ini</option>
                            <option value="all">Semua Data Guru</option>
                        </select>
                    </div>
                    <div class="card-body pt-1">
                        <t t-if="state.guruu.length > 0">
                            <div style="overflow-x: auto;">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Nama Guru</th>
                                            <th>Kelas</th>
                                            <th>Semester</th>
                                            <th>Mapel</th>
                                            <th>Tahun Ajaran</th>
                                            <th>Status</th>     
                                        </tr>
                                    </thead>
                                    <tbody class="overflow-x-scroll">
                                        <t t-foreach="state.guruu" t-as="guru" t-key="guru.id">
                                            <tr style="cursor: pointer;" t-att-id="'product-' + guru.id" t-on-click="() => this.onGuruClick(guru.id)">
                                                <td>
                                                    <t t-esc="guru.guru"/>
                                                </td>
                                                <td>
                                                    <t t-esc="guru.kelas"/>
                                                </td>
                                                <td>
                                                    <t t-esc="guru.semester"/>
                                                </td>
                                                <td>
                                                    <t t-esc="guru.mapel"/>
                                                </td>
                                                <td>
                                                    <t t-esc="guru.tahunajaran"/>
                                                </td>
                                                <td>
                                                    <span t-if="guru.status == 'confirm'" class="badge rounded-pill bg-success text-light">Confirm</span>
                                                    <span t-if="guru.status == 'draft'" class="badge rounded-pill bg-secondary text-dark">Draft</span>
                                                </td>
                                                <!-- <td>
                                                    <t t-esc="lunas.state"/>
                                                </td> -->
                                                <!-- <td class="text-center">
                                                    <span t-if="lunas.state == 'paid'" class="badge rounded-pill bg-success">Lunas</span>
                                                    <span t-if="product.state == 'waiting'" class="badge rounded-pill bg-warning text-dark">Waiting</span>
                                                    <span t-if="product.state == 'confirmed'" class="badge rounded-pill bg-info text-dark">Confirm</span>
                                                    <span t-if="product.state == 'assigned'" class="badge rounded-pill bg-primary">Ready</span>
                                                    <span t-if="product.state == 'done'" class="badge rounded-pill bg-success">Done</span>
                                                    <span t-if="product.state == 'cancel'" class="badge rounded-pill bg-danger">Cancelled</span> 
                                                </td> -->
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="text-center p-3">
                                <span class="ms-2">Data tidak ditemukan</span>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>