<t t-name="owl.EkskulList" owl="1">
    <div class="row w-100 h-100 m-0" style="font-size: 12px; line-height: 1.5;">
        <div class="col-lg-12 p-0">
            <div class="card shadow-sm border-0 rounded-0">
                <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
                    <h3 class="card-title mb-0">Kehadiran Ekskul</h3>
                </div>

                <div class="card-body pt-2">
                    <t t-if="state.items.length > 0">
                        <div style="overflow-x: auto;">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Santri</th>
                                        <th>Ekskul</th>
                                        <th>Pembimbing</th>
                                        <th>Kehadiran</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.items" t-as="guru" t-key="guru.id">
                                        <tr style="cursor: pointer;" t-att-id="'guru-' + guru.id" t-on-click="() => this.openRecord(guru.id)">
                                            <td>
                                                <t t-esc="guru.nama"/>
                                            </td>
                                            <td>
                                                <t t-esc="guru.ekskul"/>
                                            </td>
                                            <td>
                                                <t t-esc="guru.pembimbing"/>
                                            </td>
                                            <td>
                                                <t t-if="guru.kehadiran == 'Hadir'">
                                                    <span class="badge rounded-pill bg-primary">Hadir</span>
                                                </t>
                                                <t t-elif="guru.kehadiran == 'Izin'">
                                                    <span class="badge rounded-pill bg-info text-dark">Izin</span>
                                                </t>
                                                <t t-elif="guru.kehadiran == 'Alpa'">
                                                    <span class="badge rounded-pill bg-danger">Alpa</span>
                                                </t>
                                                <t t-elif="guru.kehadiran == 'Sakit'">
                                                    <span class="badge rounded-pill bg-secondary">Sakit</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="text-center p-3 text-muted">
                            <i class="fa fa-info-circle me-1"></i> Data tidak ditemukan
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </div>
</t>