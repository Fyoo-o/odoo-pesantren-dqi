<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="owl.GuruKpiCard" owl="1">
        <div class="row mx-0">
            <t t-foreach="state.kpiData" t-as="kpi" t-key="kpi.name">
                <div class="col-lg-4 col-md-6 col-sm-12 px-1 my-2" t-att-data-name="kpi.name" t-on-click="handleKpiCardClick">

                    <div class="d-flex justify-content-between align-items-center kpi-card shadow-sm py-3 px-4 w-100"
                         style="background-color: #ffffff; border-radius: 4px; cursor: pointer; height: 100%;">
                        <div class="text-start">
                            <h5 t-esc="kpi.value" class="fw-bold" style="font-size: 25px; color: #16a34a;"/>
                            <div class="text-muted" style="font-size: 13px;">
                                <span t-esc="kpi.name"/>
                            </div>
                        </div>

                        <div class="text-end mb-4" style="font-size: 2em; color: #16a34a;">
                            <i t-att-class="'fa ' + kpi.icon"/>
                        </div>
                    </div>

                </div>
            </t>
        </div>
    </t>
</templates>
