<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OrangtuaPengumumanCard" owl="1">
    <div class="card shadow-sm border-0 rounded-3 h-100 pengumuman-card">
      <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <div class="p-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background-color: #fef3c7;">
            <i class="fa fa-bullhorn" style="font-size: 16px; color: #d97706;"></i>
          </div>
          <div>
            <h5 class="mb-0 fw-bold text-dark" style="font-size: 1.05rem;">Pengumuman Pesantren</h5>
            <small class="text-muted">Informasi dan edaran resmi dari pihak pesantren</small>
          </div>
        </div>
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" t-on-click="openAllPengumuman">
          <i class="fa fa-list me-1"></i> Lihat Semua
        </button>
      </div>
      <div class="card-body p-4">
        <t t-if="state.isLoading">
          <div class="d-flex align-items-center justify-content-center py-5">
            <i class="fa fa-spinner fa-spin text-primary me-2"></i>
            <span class="text-muted">Memuat pengumuman...</span>
          </div>
        </t>
        <t t-elif="state.hasData">
          <div class="row g-3">
            <t t-foreach="state.pengumumanList" t-as="p" t-key="p.id">
              <div class="col-12 col-md-6 col-lg-4">
                <div class="p-3 border rounded-3 h-100 pengumuman-item"
                     t-on-click="() => this.onPengumumanClick(p.id)"
                     style="transition: all 0.2s ease; cursor: pointer; border-left: 4px solid #0d9488 !important; background-color: #fafafa;">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-secondary-subtle text-dark fw-normal px-2 py-1" style="font-size: 0.75rem;">
                      <i class="fa fa-calendar-alt me-1 text-primary"></i> <t t-esc="p.date"/>
                    </span>
                  </div>
                  <h6 class="fw-bold text-dark mb-1 text-truncate" t-att-title="p.name">
                    <t t-esc="p.name"/>
                  </h6>
                  <p class="text-secondary small mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.85rem; line-height: 1.4;">
                    <t t-esc="p.preview"/>
                  </p>
                </div>
              </div>
            </t>
          </div>
        </t>
        <t t-else="">
          <div class="text-center py-4">
            <div class="mb-2">
              <i class="fa fa-info-circle text-muted" style="font-size: 28px;"></i>
            </div>
            <p class="text-muted mb-0">Belum ada pengumuman terbaru saat ini.</p>
          </div>
        </t>
      </div>
    </div>
  </t>
</templates>
