<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OrangtuaPengumumanCard" owl="1">
    <div class="card shadow-sm border-0 rounded-3 h-100 pengumuman-card">
      <div class="card-header border-0 py-3 px-4 d-flex justify-content-between align-items-center"
           style="background: linear-gradient(135deg, #00a65a, #008d4c); border-radius: 12px 12px 0 0;">
        <div class="d-flex align-items-center gap-3">
          <div class="p-2 rounded-circle d-flex align-items-center justify-content-center shadow-sm"
               style="width: 40px; height: 40px; background-color: rgba(255, 255, 255, 0.2); backdrop-filter: blur(4px);">
            <i class="fa fa-bullhorn text-white" style="font-size: 17px;"></i>
          </div>
          <div>
            <h5 class="mb-0 fw-bold text-white" style="font-size: 1.1rem; letter-spacing: 0.2px;">Pengumuman Pesantren</h5>
            <small style="color: rgba(255, 255, 255, 0.85); font-size: 0.85rem;">Informasi dan edaran resmi dari pihak pesantren</small>
          </div>
        </div>
        <button class="btn btn-sm btn-light rounded-pill px-3 shadow-sm fw-semibold"
                t-on-click="openAllPengumuman"
                style="color: #007a48; border: none; transition: all 0.2s ease;">
          <i class="fa fa-list me-1"></i> Lihat Semua
        </button>
      </div>
      <div class="card-body p-4 bg-white" style="border-radius: 0 0 12px 12px;">
        <t t-if="state.isLoading">
          <div class="d-flex align-items-center justify-content-center py-5">
            <i class="fa fa-spinner fa-spin text-success me-2"></i>
            <span class="text-muted">Memuat pengumuman...</span>
          </div>
        </t>
        <t t-elif="state.hasData">
          <div class="row g-3">
            <t t-foreach="state.pengumumanList" t-as="p" t-key="p.id">
              <div class="col-12 col-md-6 col-lg-4">
                <div class="p-3 border rounded-3 h-100 pengumuman-item shadow-sm"
                     t-on-click="() => this.onPengumumanClick(p.id)"
                     style="transition: all 0.2s ease; cursor: pointer; border-left: 4px solid #00a65a !important; background-color: #ffffff;">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge rounded-pill px-2 py-1 text-white shadow-sm pengumuman-date-badge"
                          style="font-size: 0.75rem; background: linear-gradient(135deg, #00a65a, #008d4c); color: #ffffff !important; font-weight: 500;">
                      <i class="fa fa-calendar-alt me-1 text-white" style="color: #ffffff !important;"></i>
                      <span style="color: #ffffff !important;"><t t-esc="p.date"/></span>
                    </span>
                  </div>
                  <h6 class="fw-bold mb-1 text-truncate" t-att-title="p.name" style="font-size: 0.95rem; color: #1e293b !important;">
                    <t t-esc="p.name"/>
                  </h6>
                  <p class="small mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.85rem; line-height: 1.45; color: #64748b !important;">
                    <t t-esc="p.preview"/>
                  </p>
                </div>
              </div>
            </t>
          </div>
        </t>
        <t t-else="">
          <div class="text-center py-4">
            <div class="mb-2">
              <i class="fa fa-info-circle text-muted" style="font-size: 28px;"></i>
            </div>
            <p class="text-muted mb-0">Belum ada pengumuman terbaru saat ini.</p>
          </div>
        </t>
      </div>
    </div>
  </t>
</templates>
