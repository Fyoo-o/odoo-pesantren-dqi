<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- cdn.absensi_malam list view -->
        <record id="cdn_absensi_malam_view_tree" model="ir.ui.view">
            <field name="name">cdn.absensi_malam.view.list</field>
            <field name="model">cdn.absensi_malam</field>
            <field name="arch" type="xml">
                <list default_order="id desc">
                    <field name="name"/>
                    <field name="tgl"/>
                    <field name="siswa_id"/>
                    <field name="halaqoh_id" string="Halaqah"/>
                    <field name="kehadiran"/>
                    <field name="keterangan"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Search view -->
        <record id="cdn_absensi_malam_view_search" model="ir.ui.view">
            <field name="name">cdn.absensi_malam.view.search</field>
            <field name="model">cdn.absensi_malam</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Data"
                        filter_domain="[
                            '|', ('name', 'ilike', self),
                            '|', ('tgl', 'ilike', self),
                            '|', ('siswa_id.name', 'ilike', self),
                            '|', ('siswa_id.barcode_santri', 'ilike', self),
                            '|', ('siswa_id.nis', 'ilike', self),
                            '|', ('halaqoh_id.name', 'ilike', self),
                            '|', ('state', 'ilike', self),
                            '|', ('kehadiran', 'ilike', self),
                            ('keterangan', 'ilike', self)
                        ]"
                    />
                    <filter string="Hadir" name="filter_hadir" domain="[('kehadiran','=','hadir')]"/>
                    <filter string="Alpha" name="filter_alpha" domain="[('kehadiran','=','alpha')]"/>
                    <filter string="Izin" name="filter_izin" domain="[('kehadiran','=','izin')]"/>
                    <filter string="Sakit" name="filter_sakit" domain="[('kehadiran','=','sakit')]"/>
                    <separator/>
                    <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                    <filter string="Selesai" name="filter_done" domain="[('state','=','done')]"/>
                </search>
            </field>
        </record>

        <!-- Form view -->
        <record id="cdn_absensi_malam_view_form" model="ir.ui.view">
            <field name="name">cdn.absensi_malam.view.form</field>
            <field name="model">cdn.absensi_malam</field>
            <field name="arch" type="xml">
                <form string="Absensi Malam Santri">
                    <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    <button string="Ubah ke Draft" name="action_draft" type="object" class="btn btn-primary"
                            invisible="state == 'draft'"/>
                    <button string="Selesai" name="action_confirm" type="object" class="btn btn-primary"
                            invisible="state == 'done'"/>
                    </header>
                    <sheet>
                        <!-- Data Santri -->
                        <group string="Data Santri">
                            <group>
                                <field name="barcode" modifiers="{'readonly': [['state','=','done']]}"/>
                                <field name="siswa_id" string="Santri"
                                    options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"
                                    modifiers="{'readonly': [['state','=','done']]}"/>
                                <field name="kelas_id"
                                    options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            </group>
                            <group>
                                <field name="kamar_id"
                                    options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="halaqoh_id" string="Halaqah"
                                    options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="musyrif_id"
                                    options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            </group>
                        </group>

                        <!-- Absensi Malam -->
                        <group string="Absensi Malam">
                            <group>
                                <field name="tgl" modifiers="{'readonly': [['state','=','done']]}"/>
                            </group>
                            <group>
                                <field name="kehadiran" modifiers="{'readonly': [['state','=','done']]}"/>
                                <field name="keterangan" modifiers="{'invisible': [['kehadiran','in',['hadir','alpha']]]}"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Sequence -->
        <record id="sequence_absensi_malam" model="ir.sequence">
            <field name="name">Absensi Malam Santri</field>
            <field name="code">cdn.absensi_malam</field>
            <field name="prefix">AM/%(y)s.%(month)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <!-- Action Window -->
        <record id="cdn_absensi_malam_action" model="ir.actions.act_window">
            <field name="name">Absensi Malam Santri</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cdn.absensi_malam</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Klik untuk membuat absensi malam santri baru.
                </p>
                <p>
                    Catat kehadiran santri setiap malam: Hadir, Alpha, Izin, atau Sakit.
                </p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem id="absensi_malam_menu_act" name="Absensi Malam Santri"
                  parent="kepesantrenan_kepengasuhan_menu_categ"
                  action="cdn_absensi_malam_action"
                  sequence="11"/>
    </data>
</odoo>