<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence -->
    <record id="seq_cdn_penilaian_quran" model="ir.sequence">
        <field name="name">Penilaian Halaqoh</field>
        <field name="code">cdn.penilaian_quran</field>
        <field name="prefix">PQ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- List View -->
    <record id="view_penilaian_quran_tree" model="ir.ui.view">
        <field name="name">cdn.penilaian_quran.tree</field>
        <field name="model">cdn.penilaian_quran</field>
        <field name="arch" type="xml">
            <list default_order="name desc" create="false">
                <field name="name" optional="show"/>
                <field name="tanggal" optional="show"/>
                <field name="siswa_id" optional="show" context="{'from_guru_quran': True}"/>
                <field name="halaqoh_id" string="Halaqoh" optional="show" context="{'from_guru_quran': True}"/>
                <field name="ustadz_id" optional="show"/>

                <!-- Tahfidz -->
                <field name="surah_id" string="Surat Tahfidz" optional="hide"/>
                <field name="ayat_awal" string="Ayat Awal Tahfidz" optional="hide"/>
                <field name="ayat_akhir" string="Ayat Akhir Tahfidz" optional="hide"/>
                <field name="last_jml_baris" string="Jumlah Maqra' Tahfidz" optional="hide"/>
                <field name="last_nilai_hafalan" string="Nilai Tahfidz" optional="hide"/>
                <field name="last_predikat" string="Predikat Tahfidz" optional="hide"/>

                <!-- Tahfidz Ujian -->
                <field name="surah_id_ujian_tahfidz" string="Surat Tahfidz (Ujian)" optional="hide"/>
                <field name="ayat_awal_ujian_tahfidz" string="Ayat Awal Tahfidz (Ujian)" optional="hide"/>
                <field name="ayat_akhir_ujian_tahfidz" string="Ayat Akhir Tahfidz (Ujian)" optional="hide"/>
                <field name="nilai_ujian_tahfidz" string="Nilai Tahfidz (Ujian)" optional="hide"/>
                <field name="predikat_ujian_tahfidz" string="Predikat Tahfidz (Ujian)" optional="hide"/>

                <!-- Murajaah Harian -->
                <field name="buku_murajaah_id" string="Buku Murajaah" optional="hide"/>
                <field name="juz_murajaah" string="Juz Murajaah" optional="hide"/>
                <field name="surah_murajaah_id" string="Surah Murajaah" optional="hide"/>
                <field name="halaman_murajaah" string="Halaman Murajaah" optional="hide"/>

                <!-- Tahsin Harian -->
                <field name="buku_harian_id" string="Buku Tahsin (Harian)" optional="hide"/>
                <field name="jilid_harian_id" string="Jilid Tahsin (Harian)" optional="hide"/>
                <field name="halaman_harian" string="Halaman Tahsin (Harian)" optional="hide"/>
                <field name="nilai_harian" string="Nilai Harian (PAUD/TK)" optional="hide"/>
                <field name="surah_id_harian" string="Surat Tahsin (Harian)" optional="hide"/>
                <field name="ayat_awal_harian" string="Ayat Awal Tahsin (Harian)" optional="hide"/>
                <field name="ayat_akhir_harian" string="Ayat Akhir Tahsin (Harian)" optional="hide"/>
                <field name="nilai_tahsin_harian" string="Nilai (Harian)" optional="hide"/>
                <field name="predikat_tahsin_harian" string="Predikat Tahsin (Harian)" optional="hide"/>

                <!-- Tahsin Ujian -->
                <field name="buku_ujian_id" string="Buku Tahsin (Ujian)" optional="hide"/>
                <field name="jilid_ujian_id" string="Jilid Tahsin (Ujian)" optional="hide"/>
                <field name="halaman_ujian" string="Halaman Tahsin (Ujian)" optional="hide"/>
                <field name="surah_id_ujian" string="Surat Tahsin (Ujian)" optional="hide"/>
                <field name="ayat_awal_ujian" string="Ayat Awal Tahsin (Ujian)" optional="hide"/>
                <field name="ayat_akhir_ujian" string="Ayat Akhir Tahsin (Ujian)" optional="hide"/>
                <field name="nilai_tajwid_ujian" string="Nilai Tajwid Tahsin (Ujian)" optional="hide"/>
                <field name="nilai_makhroj_ujian" string="Nilai Makhroj Tahsin (Ujian)" optional="hide"/>
                <field name="nilai_mad_ujian" string="Nilai Mad Tahsin (Ujian)" optional="hide"/>

                <!-- Status -->
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_penilaian_quran_form" model="ir.ui.view">
        <field name="name">cdn.penilaian_quran.form</field>
        <field name="model">cdn.penilaian_quran</field>
        <field name="arch" type="xml">
            <form string="Penilaian Halaqoh" create="false">
                <header>
                    <button string="Confirm" type="object" name="action_confirm" invisible="state != 'draft'" class="oe_highlight" groups="pesantren_kesantrian.group_kesantrian_staff,pesantren_guruquran.group_guru_quran_staff,base.group_system"/>
                    <button string="Set to Draft" type="object" name="action_draft" invisible="state != 'done'" groups="pesantren_kesantrian.group_kesantrian_staff,pesantren_guruquran.group_guru_quran_staff,base.group_system"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>

                    <group string="Informasi Santri">
                        <group>
                            <field name="barcode" readonly="1"/>
                            <field name="siswa_id" required="1" options="{'no_create': True, 'no_open': True}" context="{'from_guru_quran': True}"/>
                            <field name="kelas_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="kamar_id" readonly="1"/>
                            <field name="halaqoh_id" readonly="1" context="{'from_guru_quran': True}"/>
                            <field name="musyrif_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Pelaksanaan">
                        <group>
                            <field name="tanggal"/>
                            <field name="ustadz_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="sesi_id"/>
                            <field name="jenjang_display"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- TAB TAHFIDZ -->
                        <page string="Tahfidz">
                            <!-- Info Tahfidz Terakhir -->
                            <group string="Tahfidz Terakhir" colspan="4" invisible="not siswa_id">
                                <group>
                                    <field name="last_surah_id" readonly="1"/>
                                    <field name="last_ayat_akhir" readonly="1"/>
                                </group>
                            </group>
                            <!-- Tabel Dinamis Setoran Hafalan -->
                            <field name="tahfidz_line_ids">
                                <list editable="bottom">
                                    <field name="surah_id"/>
                                    <field name="ayat_awal"/>
                                    <field name="ayat_akhir"/>
                                    <field name="jml_baris"/>

                                    <!-- Nilai Hafalan hanya muncul untuk jenjang SD ke atas -->
                                    <field name="nilai_hafalan" invisible="penilaian_id.jenjang_display in ['paud','tk','tk/ra']"/>

                                    <field name="predikat" readonly="1"/>
                                    <field name="keterangan"/>
                                </list>
                            </field>
                        </page>

                        <!-- TAB TAHFIDZ UJIAN -->
                        <page string="Tahfidz Ujian">
                            <group string="Buku Halaman">
                                <group>
                                    <field name="buku_tahfidz_ujian_id"/>
                                    <field name="juz_tahfidz_ujian"/>
                                </group>
                                <group>
                                    <field name="halaman_tahfidz_ujian"/>
                                </group>
                            </group>
                            <group string="Penilaian">
                                <group>
                                    <field name="surah_id_ujian_tahfidz"/>
                                    <field name="ayat_awal_ujian_tahfidz"/>
                                    <field name="ayat_akhir_ujian_tahfidz"/>
                                </group>
                                <group>
                                    <field name="nilai_ujian_tahfidz" string="Nilai"/>
                                    <field name="predikat_ujian_tahfidz" />
                                </group>
                            </group>
                            <group string="Catatan">
                                <field name="catatan_tahfidz" nolabel="1" placeholder="Catatan untuk tahfidz ujian..."/>
                            </group>
                        </page>

                        <!-- TAB Murajaah Harian -->
                        <page string="Murajaah Harian">
                            <group string="Informasi Murajaah">
                                <group>
                                    <field name="buku_murajaah_id" readonly="1"/>
                                    <field name="juz_murajaah" height="10px"/>
                                </group>
                                <group>
                                    <field name="surah_murajaah_id"/>
                                    <field name="halaman_murajaah"/>
                                </group>
                            </group>
                            <group string="Catatan">
                                <field name="catatan_murajaah_harian" nolabel="1" placeholder="Catatan untuk murajaah harian..."/>
                            </group>
                        </page>

                        <!-- TAB TAHsin HARIAN -->
                        <page string="Tahsin Harian">
                            <group string="Buku Halaman">
                                <group>
                                    <field name="buku_harian_id"/>
                                    <field name="jilid_harian_id"/>
                                </group>
                                <group>
                                    <field name="halaman_harian"/>
                                    <field name="nilai_harian" invisible="jenjang_display not in ['paud','tk','tk/ra']" />
                                </group>
                            </group>
                            <group string="Penilaian" invisible="jenjang_display in ['paud','tk','tk/ra']">
                                <group invisible="jenjang_display in ['paud','tk','tk/ra']">
                                    <field name="surah_id_harian"/>
                                    <field name="ayat_awal_harian"/>
                                    <field name="ayat_akhir_harian"/>
                                </group>
                                <group invisible="jenjang_display in ['paud','tk','tk/ra']">
                                    <field name="nilai_tahsin_harian" />
                                    <field name="predikat_tahsin_harian" />
                                </group>
                            </group>
                            <group string="Catatan">
                                <field name="catatan_harian" nolabel="1" placeholder="Catatan untuk tahsin harian..."/>
                            </group>
                        </page>

                        <!-- TAB TAHsin UJIAN -->
                        <page string="Tahsin Ujian">
                            <group string="Buku Halaman">
                                <group>
                                    <field name="buku_ujian_id"/>
                                    <field name="jilid_ujian_id"/>
                                </group>
                                <group>
                                    <field name="halaman_ujian"/>
                                </group>
                            </group>
                            <group string="Penilaian">
                                <group>
                                    <field name="surah_id_ujian"/>
                                    <field name="ayat_awal_ujian"/>
                                    <field name="ayat_akhir_ujian"/>
                                </group>
                                <group>
                                    <field name="nilai_tajwid_ujian"/>
                                    <field name="nilai_makhroj_ujian"/>
                                    <field name="nilai_mad_ujian"/>
                                </group>
                            </group>
                            <group string="Catatan">
                                <field name="catatan_ujian" nolabel="1" placeholder="Catatan untuk tahsin ujian..."/>
                            </group>
                        </page>

                        <!-- TAB Riwayat Hafalan -->
                        <page string="Riwayat Hafalan">
                            <field name="riwayat_hafalan_ids">
                                <list default_order="tanggal_penilaian desc, sequence desc">
                                    <field name="tanggal_penilaian" string="Tanggal"/>
                                    <field name="surah_id" string="Surah"/>
                                    <field name="ayat_awal" string="Ayat Awal"/>
                                    <field name="ayat_akhir" string="Ayat Akhir"/>
                                    <field name="nilai_hafalan" string="Nilai Hafalan"/>
                                    <field name="predikat" string="Predikat Hafalan"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_penilaian_quran_search" model="ir.ui.view">
        <field name="name">cdn.penilaian_quran.search</field>
        <field name="model">cdn.penilaian_quran</field>
        <field name="arch" type="xml">
            <search string="Cari Penilaian Halaqoh">
                <field name="name" string="Referensi" filter_domain="['|', ('name', 'ilike', self), ('siswa_id.name', 'ilike', self)]"/>
                <field name="siswa_id" context="{'from_guru_quran': True}"/>
                <field name="halaqoh_id" context="{'from_guru_quran': True}" />
                <field name="ustadz_id"/>
                <field name="tanggal"/>
                <field name="state"/>

                <!-- 🧩 Filter Berdasarkan Jenis Data -->
                <separator/>

                <!-- Filter Tahfidz: Tampilkan jika ADA data tahfidz ATAU SEMUA kosong -->
                <filter name="filter_tahfidz_only" string="Setoran Tahfidz" domain="['|',
                                ('tahfidz_line_ids', '!=', False),
                                '&amp;', '&amp;', '&amp;',
                                    ('tahfidz_line_ids', '=', False),
                                    ('buku_harian_id', '=', False),
                                    ('buku_ujian_id', '=', False),
                                    ('juz_murajaah', '=', False)
                                ]"/>

                <!-- Filter Murajaah Harian: Tampilkan jika ADA data murajaah ATAU SEMUA kosong -->
                <filter name="filter_murajaah_harian" string="Murajaah Harian" domain="['|',
                                ('juz_murajaah', '!=', False),
                                '&amp;', '&amp;', '&amp;',
                                    ('tahfidz_line_ids', '=', False),
                                    ('buku_harian_id', '=', False),
                                    ('buku_ujian_id', '=', False),
                                    ('juz_murajaah', '=', False)
                                ]"/>

                <!-- Filter Tahsin Harian: Tampilkan jika ADA data tahsin harian ATAU SEMUA kosong -->
                <filter name="filter_tahsin_harian" string="Tahsin Harian" domain="['|',
                                ('buku_harian_id', '!=', False),
                                '&amp;', '&amp;', '&amp;',
                                    ('tahfidz_line_ids', '=', False),
                                    ('buku_harian_id', '=', False),
                                    ('buku_ujian_id', '=', False),
                                    ('juz_murajaah', '=', False)
                                ]"/>

                <!-- Filter Tahsin Ujian: Tampilkan jika ADA data tahsin ujian ATAU SEMUA kosong -->
                <filter name="filter_tahsin_ujian" string="Tahsin Ujian" domain="['|',
                                ('buku_ujian_id', '!=', False),
                                '&amp;', '&amp;', '&amp;',
                                    ('tahfidz_line_ids', '=', False),
                                    ('buku_harian_id', '=', False),
                                    ('buku_ujian_id', '=', False),
                                    ('juz_murajaah', '=', False)
                                ]"/>

                <group expand="0" string="Group By">
                    <filter name="group_siswa" string="Santri" context="{'group_by': 'siswa_id'}"/>
                    <filter name="group_tanggal" string="Tanggal" context="{'group_by': 'tanggal'}"/>
                    <filter name="group_halaqoh" string="Halaqoh" context="{'group_by': 'halaqoh_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>

                <filter name="filter_today" string="Hari Ini" domain="[('tanggal','=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Hari Ini &amp; Kemarin" name="today_yesterday" domain="[
                            ('tanggal', '&gt;=', (context_today() - relativedelta(days=1))),
                            ('tanggal', '&lt;=', context_today())
                        ]"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_done" string="Selesai" domain="[('state','=','done')]"/>
            </search>
        </field>
    </record>
    <record id="cdn_penilaian_quran_view_calendar" model="ir.ui.view">
        <field name="name">cdn.penilaian_quran.view.calendar</field>
        <field name="model">cdn.penilaian_quran</field>
        <field name="arch" type="xml">
            <calendar string="Penilaian Halaqoh" date_start="tanggal">
                <!-- Add your fields here -->
                <field name="name" />
            </calendar>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_penilaian_quran" model="ir.actions.act_window">
        <field name="name">Penilaian Halaqoh</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cdn.penilaian_quran</field>
        <field name="view_mode">list,form,graph,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat penilaian Halaqoh baru untuk santri.
            </p>
        </field>
        <field name="context">{'from_guru_quran': True}</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_penilaian_quran" name="Penilaian Halaqoh" parent="kepesantrenan_halaqoh_menu_categ" action="action_penilaian_quran" sequence="15"/>
</odoo>