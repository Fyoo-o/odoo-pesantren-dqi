<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cdn_orangtua.PasswordToggleField" owl="1">
        <div class="o_field_password_toggle d-flex align-items-center gap-2">
            <input t-ref="input" class="o_input flex-grow-1" t-att-type="inputType" t-att-id="props.id" t-att-name="props.name" t-att-placeholder="props.placeholder" t-att-disabled="props.readonly" t-att-required="props.required" t-model="props.record.data[props.name]" />
            <button type="button" class="btn btn-outline-success btn-link" t-on-click="togglePasswordVisibility" t-att-disabled="props.readonly" tabindex="-1">
                <i t-attf-class="fa fa-{{ state.showPassword ? 'eye-slash' : 'eye' }}" t-att-title="state.showPassword ? 'Hide Password' : 'Show Password'"/>
            </button>
        </div>
    </t>
</templates>