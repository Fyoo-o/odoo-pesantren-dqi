<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- cdn.ref_jam_pelajaran list view -->
        <record id="model_name_view_tree" model="ir.ui.view">
            <field name="name">cdn.ref_jam_pelajaran.view.list</field>
            <field name="model">cdn.ref_jam_pelajaran</field>
            <field name="arch" type="xml">
                <list default_order="name asc">
                    <field name="name" />
                    <field name="company_id" optional="show" options="{'no_create_edit': True, 'no_create': True}" />
                    <field name="start_time" widget="float_time" />
                    <field name="end_time" widget="float_time" />
                    <field name="active" widget="boolean_toggle" optional="show" />
                </list>
            </field>
        </record>
        <!-- cdn.ref_jam_pelajaran form view -->
        <record id="cdn_ref_jam_pelajaran_view_form" model="ir.ui.view">
            <field name="name">cdn.ref_jam_pelajaran.view.form</field>
            <field name="model">cdn.ref_jam_pelajaran</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                        <group>
                            <field name="name" />
                            <field name="company_id" options="{'no_create_edit': True, 'no_create': True}" />
                            <field name="start_time" widget="float_time" />
                            <field name="end_time" widget="float_time" />
                            <field name="active" invisible="1" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- cdn.ref_jam_pelajaran search view -->
        <record id="cdn_ref_jam_pelajaran_view_search" model="ir.ui.view">
            <field name="name">cdn.ref_jam_pelajaran.view.search</field>
            <field name="model">cdn.ref_jam_pelajaran</field>
            <field name="arch" type="xml">
                <search string="Jam Pelajaran">
                    <field name="name" />
                    <field name="company_id" />
                    <separator />
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                    <group string="Group By..">
                        <filter string="Lembaga" name="group_by_company" context="{'group_by':'company_id'}" />
                    </group>
                </search>
            </field>
        </record>
        <!-- cdn.ref_jam_pelajaran action window -->
        <record id="cdn_ref_jam_pelajaran_action" model="ir.actions.act_window">
            <field name="name">Jam Pelajaran</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cdn.ref_jam_pelajaran</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="cdn_ref_jam_pelajaran_view_search" />
        </record>
        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="cdn_ref_jam_pelajaran_menu_act" name="Jam Pelajaran"
            parent="pengaturan_akademik_menu_categ" action="cdn_ref_jam_pelajaran_action"
            sequence="60" />
    </data>
</odoo>