<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- tree view -->
        <record id="view_cdn_siswa_tree" model="ir.ui.view">
            <field name="name">cdn_siswa_tree</field>
            <field name="model">cdn.siswa</field>
            <field name="type">list</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <list string="Siswa" expand="1">
                    <header>
                        <button name="action_recharge_wallet_mass" string="Isi Dompet" type="object"
                            class="btn btn-primary" />
                    </header>
                    <field name="name" />
                    <field name="namapanggilan" string="Panggilan" />
                    <field name="nis" />
                    <field name="nisn" />
                    <field name="tmp_lahir" />
                    <field name="tgl_lahir" />
                    <field name="jns_kelamin" />
                    <field name="street" optional="hide" />
                    <field name="mobile" optional="hide" />
                    <field name="tahunajaran_id" />
                    <field name="ruang_kelas_id" />
                    <field name="jenjang" />
                    <field name="status_akun" widget="badge"
                        decoration-success="status_akun == 'aktif'"
                        decoration-warning="status_akun == 'nonaktif'"
                        decoration-danger="status_akun == 'blokir'" />
                </list>
            </field>
        </record>
        <!-- form view -->
        <record id="view_cdn_siswa_form" model="ir.ui.view">
            <field name="name">cdn_siswa_form</field>
            <field name="model">cdn.siswa</field>
            <field name="type">form</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <form string="Siswa">
                    <header>
                        <button name="action_generate_nis" type="object" string="Buat NIS"
                            class="oe_highlight"
                            groups="pesantren_kesantrian.group_kesantrian_staff" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <field name="image_1920" widget="image" class="oe_avatar"
                            options="{'preview_image': 'image_128'}" />
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Nama Lengkap Siswa" />
                            <h1>
                                <field name="name" style="width:50%"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="namapanggilan" string="Panggilan" />
                                <field name="street" string="Alamat Rumah" />
                                <field name="street2" string="RT / RW" />
                                <field name="zip" string="Kode Pos" />
                                <field name="barcode_santri" string="Kartu Siswa" readonly="True" />
                            </group>
                            <group>
                                <field name="propinsi_id" />
                                <field name="kota_id" domain="[('propinsi_id','=',propinsi_id)]" />
                                <field name="kecamatan_id" domain="[('kota_id','=',kota_id)]" />
                            </group>
                        </group>
                        <notebook>
                            <page name="info_siswa" string="Info Siswa">
                                <group string="Akademik">
                                    <group>
                                        <field name="nis"/>
                                        <field name="tahunajaran_id" />
                                        <field name="jenjang" />
                                        <field name="nama_sekolah" />
                                        <field name="jurusan_sma" invisible="1" />
                                    </group>
                                    <group>
                                        <field name="nisn" />
                                        <field name="ruang_kelas_id" readonly="1" />
                                        <field name="tingkat" domain="[('jenjang', '=', jenjang)]"
                                            options="{'no_create_edit':True, 'no_create':True, 'no_open': True}" />
                                        <field name="kewarganegaraan" />
                                    </group>
                                </group>
                                <group string="Siswa">
                                    <group>
                                        <field name="panggilan" string="Panggilan" />
                                        <field name="tgl_lahir" />
                                        <field name="jns_kelamin" string="Jenis Kelamin" />
                                        <field name="nik" string="NIK" />
                                        <field name="jml_saudara_kandung" string="Jumlah Saudara" />
                                        <field name="hobi" />
                                    </group>
                                    <group>
                                        <field name="tmp_lahir" />
                                        <field name="gol_darah" />
                                        <field name="agama" />
                                        <field name="anak_ke" />
                                        <field name="bahasa" />
                                        <field name="cita_cita" />
                                    </group>
                                </group>
                                <group string="Pendidikan Sebelumnya">
                                    <group>
                                        <field name="asal_sekolah" />
                                        <field name="kepsek_sekolah_asal" string="Kepala Sekolah" />
                                        <field name="status_sekolah_asal" string="Status" />
                                    </group>
                                    <group>
                                        <field name="telp_asal_sek" string="No Telepon" />
                                        <field name="alamat_asal_sek" string="Alamat" />
                                        <field name="prestasi_sebelum" />
                                        <field name="bakat" string="Bakat Siswa"
                                            widget="many2many_tags" />
                                    </group>
                                </group>
                                <group string="Nilai Rata-Rata Raport Kelas">
                                    <group>
                                        <field name="raport_4sd_1" widget="integer" />
                                        <field name="raport_5sd_1" widget="integer" />
                                        <field name="raport_6sd_1" widget="integer" />
                                    </group>
                                    <group>
                                        <field name="raport_4sd_2" widget="integer" />
                                        <field name="raport_5sd_2" widget="integer" />
                                        <field name="baca_quran" />
                                    </group>
                                </group>
                            </page>
                            <page name="ortu" string="Orang Tua">
                                <!-- BARIS AKUN TERHUBUNG DI ATAS SENDIRI -->
                                <group>
                                    <field name="orangtua_ids" widget="many2many_tags" options="{'no_create_edit': True}" 
                                           string="Akun Terhubung" 
                                           placeholder="Pilih atau cari akun orang tua/wali yang terhubung..."/>
                                    <field name="orangtua_id" invisible="1"/>
                                </group>

                                <!-- NOTE PANDUAN PENGGUNAAN & SINKRONISASI -->
                                <div class="alert alert-info d-flex align-items-start mb-3" role="alert">
                                    <i class="fa fa-info-circle fa-2x me-3 text-info mt-1"/>
                                    <div>
                                        <strong class="d-block mb-1">Catatan Penggunaan &amp; Sinkronisasi Akun Terhubung:</strong>
                                        <div class="text-muted small">
                                            • <strong>Sinkronisasi Otomatis:</strong> Akun yang dipilih atau dibuat pada formulir <em>Identitas Ayah</em>, <em>Identitas Ibu</em>, dan <em>Identitas Wali</em> di bawah akan otomatis terdaftar pada baris <strong>Akun Terhubung</strong> di atas.<br/>
                                            • <strong>Penambahan Manual:</strong> Anda juga dapat menambahkan akun secara manual langsung pada baris <strong>Akun Terhubung</strong> di atas jika santri memiliki wali atau penanggung jawab tambahan (misal: paman, kakek, dsb).<br/>
                                            • <strong>Hak Akses Portal:</strong> Seluruh akun yang terdaftar pada <em>Akun Terhubung</em> dapat login ke portal wali santri untuk memantau data, kehadiran, tahfidz, dan tagihan santri ini.<br/>
                                            • <strong>Pembuatan Akun Baru:</strong> Jika orang tua belum memiliki akun, cukup lengkapi data identitas di bawah dan centang <em>"Buat Akun Portal"</em>, akun akan otomatis dibuat dan terhubung saat disimpan.
                                        </div>
                                    </div>
                                </div>

                                <!-- DATA AYAH -->
                                <group string="Identitas Ayah">
                                    <group>
                                        <field name="ayah_id" options="{'no_create_edit': True}" placeholder="Pilih akun Ayah jika sudah terdaftar..." />
                                        <field name="ayah_nama" />
                                        <field name="ayah_telp" string="No Telepon/HP (WhatsApp)" />
                                        <field name="ayah_email" string="Email" widget="email" />
                                        <field name="ayah_pekerjaan_id" string="Pekerjaan" />
                                        <field name="ayah_kantor" string="Alamat Kantor" />
                                    </group>
                                    <group>
                                        <field name="ayah_tmp_lahir" string="Tempat Lahir" />
                                        <field name="ayah_tgl_lahir" string="Tgl Lahir" />
                                        <field name="ayah_agama" string="Agama" />
                                        <field name="ayah_warganegara" string="Kewarganegaraan" />
                                        <field name="ayah_pendidikan_id" string="Pendidikan" />
                                        <field name="ayah_penghasilan" string="Penghasilan/bln" />
                                        <field name="ayah_user_id" string="User Login Portal" invisible="not ayah_user_id" readonly="1" />
                                        <field name="ayah_create_user" invisible="ayah_id or ayah_user_id" />
                                        <field name="ayah_password" string="Password Akun Ayah" widget="password_toggle" invisible="ayah_id or not ayah_create_user" placeholder="Password untuk login portal" />
                                    </group>
                                </group>

                                <!-- DATA IBU -->
                                <group string="Identitas Ibu">
                                    <group>
                                        <field name="ibu_id" options="{'no_create_edit': True}" placeholder="Pilih akun Ibu jika sudah terdaftar..." />
                                        <field name="ibu_nama" />
                                        <field name="ibu_telp" string="No Telepon/HP (WhatsApp)" />
                                        <field name="ibu_email" string="Email" widget="email" />
                                        <field name="ibu_pekerjaan_id" string="Pekerjaan" />
                                        <field name="ibu_kantor" string="Alamat Kantor" />
                                    </group>
                                    <group>
                                        <field name="ibu_tmp_lahir" string="Tempat Lahir" />
                                        <field name="ibu_tgl_lahir" string="Tgl Lahir" />
                                        <field name="ibu_agama" string="Agama" />
                                        <field name="ibu_warganegara" string="Kewarganegaraan" />
                                        <field name="ibu_pendidikan_id" string="Pendidikan" />
                                        <field name="ibu_penghasilan" string="Penghasilan/bln" />
                                        <field name="ibu_user_id" string="User Login Portal" invisible="not ibu_user_id" readonly="1" />
                                        <field name="ibu_create_user" invisible="ibu_id or ibu_user_id" />
                                        <field name="ibu_password" string="Password Akun Ibu" widget="password_toggle" invisible="ibu_id or not ibu_create_user" placeholder="Password untuk login portal" />
                                    </group>
                                </group>

                                <!-- DATA WALI -->
                                <group string="Identitas Wali (Opsional)">
                                    <group>
                                        <field name="wali_id" options="{'no_create_edit': True}" placeholder="Pilih akun Wali jika sudah terdaftar..." />
                                        <field name="wali_nama" />
                                        <field name="wali_hubungan" string="Hubungan dg Siswa" />
                                        <field name="wali_telp" string="No Telepon/HP" />
                                        <field name="wali_email" string="Email" widget="email" />
                                    </group>
                                    <group>
                                        <field name="wali_tmp_lahir" string="Tempat Lahir" />
                                        <field name="wali_tgl_lahir" string="Tgl Lahir" />
                                        <field name="wali_agama" string="Agama" />
                                        <field name="wali_user_id" string="User Login Portal" invisible="not wali_user_id" readonly="1" />
                                        <field name="wali_create_user" invisible="wali_id or wali_user_id" />
                                        <field name="wali_password" string="Password Akun Wali" widget="password_toggle" invisible="wali_id or not wali_create_user" placeholder="Password untuk login portal" />
                                    </group>
                                </group>
                            </page>
                            <page name="harga_khusus" string="Harga Khusus">
                                <group>
                                    <field name="bebasbiaya" />
                                </group>
                                <group>
                                    <field name="harga_komponen" string=" ">
                                        <list>
                                            <field name="name" />
                                            <field name="keterangan" />
                                            <field name="disc_amount" />
                                            <field name="disc_persen" />
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page name="organisasi" string="Organisasi">
                                <field name="organisasi_ids" nolabel="1">
                                    <list create="false">
                                        <field name="position" />
                                        <field name="organisasi_id" />
                                    </list>
                                </field>
                            </page>
                            <page name="ekstrakulikuler" string="Ekstrakulikuler">
                                <field name="ekstrakulikuler_ids" nolabel="1">
                                    <list create="false">
                                        <field name="name" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter" groups="pesantren_base.group_sekolah_manager">
                        <chatter>
                            <field name="message_follower_ids" widget="mail_followers" />
                            <field name="activity_ids" widget="mail_activity" />
                            <field name="message_ids" widget="mail_thread"
                                options="{'display_log_button': True}" />
                        </chatter>
                    </div>
                </form>
            </field>
        </record>
        <!-- search -->
        <record id="view_cdn_siswa_search" model="ir.ui.view">
            <field name="name">cdn_siswa</field>
            <field name="model">cdn.siswa</field>
            <field name="arch" type="xml">
                <search string="Siswa">
                    <field name="name" string="Data"
                        filter_domain="[
                            '|', ('name', 'ilike', self),
                            '|', ('nis', 'ilike', self),
                            '|', ('nisn', 'ilike', self),
                            '|', ('tmp_lahir', 'ilike', self),
                            '|', ('rt_rw', 'ilike', self),
                            '|', ('nik', 'ilike', self),
                            '|', ('tahunajaran_id.name', 'ilike', self),
                            '|', ('kamar_id', 'ilike', self),
                            '|', ('ayah_nama', 'ilike', self),
                            '|', ('ibu_nama', 'ilike', self),
                            '|', ('barcode_santri', 'ilike', self),
                            '|', ('barcode', 'ilike', self),
                            '|', ('cita_cita', 'ilike', self),
                            '|', ('nama_sekolah', 'ilike', self),
                            '|', ('ruang_kelas_id.name', 'ilike', self),
                            '|', ('propinsi_id.name', 'ilike', self),
                            '|', ('kecamatan_id.name', 'ilike', self),
                            '|', ('kota_id.name', 'ilike', self),
                            '|', ('street', 'ilike', self),
                            '|', ('street2', 'ilike', self),
                            '|', ('mobile', 'ilike', self),
                            '|', ('ayah_telp', 'ilike', self),
                            '|', ('ibu_telp', 'ilike', self),
                            '|', ('wali_nama', 'ilike', self),
                            '|', ('wali_telp', 'ilike', self),
                            '|', ('gol_darah', 'ilike', self),
                            ('jns_kelamin', 'ilike', self)
                        ]" />
                    <filter string="NIS" name="filter_by_nis" domain="[('nis','=','')]" />
                    <filter string="NISN Kosong" name="filter_by_nisn" domain="[('nisn','=',False)]" />
                    <filter string="Jenjang" name="filter_jenjang"
                        domain="[('jenjang', '!=', False)]" />
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                    <field name="name" select="True" />
                    <field name="nis" select="True" />
                    <field name="nisn" select="True" />

                    <field name="jenjang" select="True" />
                    <field name="ayah_nama" select="True" />
                    <field name="ayah_telp" select="True" />
                    <field name="ibu_nama" select="True" />
                    <field name="ibu_telp" select="True" />
                    <field name="ibu_email" select="True" />
                    <field name="wali_nama" select="True" />
                    <field name="wali_telp" select="True" />
                    <field name="propinsi_id" select="True" />
                    <field name="kota_id" select="True" />
                    <field name="kecamatan_id" select="True" />
                    <field name="orangtua_id" select="True" />
                    <field name="tahunajaran_id" select="True" />
                    <field name="ruang_kelas_id" select="True" />
                    <group string="Group By..">
                        <filter string="Jenjang" domain="[]" name="group_by_jenjang"
                            context="{'group_by':'jenjang'}" />
                        <filter string="Ayah pekerjaan" domain="[]"
                            name="group_by_ayah_pekerjaan_id"
                            context="{'group_by':'ayah_pekerjaan_id'}" />
                        <filter string="Ayah pendidikan" domain="[]"
                            name="group_by_ayah_pendidikan_id"
                            context="{'group_by':'ayah_pendidikan_id'}" />
                        <filter string="Ibu pekerjaan" domain="[]" name="group_by_ibu_pekerjaan_id"
                            context="{'group_by':'ibu_pekerjaan_id'}" />
                        <filter string="Ibu pendidikan" domain="[]"
                            name="group_by_ibu_pendidikan_id"
                            context="{'group_by':'ibu_pendidikan_id'}" />
                        <filter string="Provinsi" domain="[]" name="group_by_propinsi_id"
                            context="{'group_by':'propinsi_id'}" />
                        <filter string="Kota" domain="[]" name="group_by_kota_id"
                            context="{'group_by':'kota_id'}" />
                        <filter string="Kecamatan" domain="[]" name="group_by_kecamatan_id"
                            context="{'group_by':'kecamatan_id'}" />
                        <filter string="Orangtua" domain="[]" name="group_by_orangtua_id"
                            context="{'group_by':'orangtua_id'}" />
                        <filter string="Tahunajaran" domain="[]" name="group_by_tahunajaran_id"
                            context="{'group_by':'tahunajaran_id'}" />
                        <filter string="Ruang kelas" domain="[]" name="group_by_ruang_kelas_id"
                            context="{'group_by':'ruang_kelas_id'}" />
                    </group>
                </search>
            </field>
        </record>
        <!-- kanban , to show image, please add image_small in the model -->
        <record id="view_cdn_siswa_kanban" model="ir.ui.view">
            <field name="name">cdn_siswa</field>
            <field name="model">cdn.siswa</field>
            <field name="arch" type="xml">
                <kanban version="7.0">
                    <field name="id" />
                    <field name="name" />
                    <field name="nis" />
                    <field name="nisn" />
                    <field name="tmp_lahir" />
                    <field name="tgl_lahir" />
                    <field name="gol_darah" />
                    <field name="jns_kelamin" />
                    <field name="kewarganegaraan" />
                    <field name="agama" />
                    <field name="panggilan" string="Panggilan" />
                    <field name="nik" />
                    <field name="anak_ke" />
                    <field name="jml_saudara_kandung" />
                    <field name="bahasa" />
                    <field name="ayah_nama" />
                    <field name="ayah_tmp_lahir" />
                    <field name="ayah_tgl_lahir" />
                    <field name="ayah_warganegara" />
                    <field name="ayah_telp" />
                    <field name="ayah_email" />
                    <field name="ayah_kantor" />
                    <field name="ayah_penghasilan" />
                    <field name="ayah_agama" />
                    <field name="ibu_nama" />
                    <field name="ibu_tmp_lahir" />
                    <field name="ibu_tgl_lahir" />
                    <field name="ibu_warganegara" />
                    <field name="ibu_telp" />
                    <field name="ibu_email" />
                    <field name="ibu_kantor" />
                    <field name="ibu_penghasilan" />
                    <field name="ibu_agama" />
                    <field name="wali_nama" />
                    <field name="wali_tmp_lahir" />
                    <field name="wali_tgl_lahir" />
                    <field name="wali_telp" />
                    <field name="wali_email" />
                    <field name="wali_agama" />
                    <field name="wali_hubungan" />
                    <field name="ayah_pekerjaan_id" />
                    <field name="ayah_pendidikan_id" />
                    <field name="ibu_pekerjaan_id" />
                    <field name="ibu_pendidikan_id" />
                    <field name="propinsi_id" />
                    <field name="kota_id" />
                    <field name="kecamatan_id" />
                    <field name="orangtua_id" />
                    <field name="tahunajaran_id" />
                    <field name="ruang_kelas_id" />
                    <field name="image_256" />
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                <div class="oe_kanban_details">
                                    <h4>
                                        <a type="open">
                                            <field name="name" />
                                        </a>
                                    </h4>
                                    <ul>
                                        <li>
                                            <span class="text-muted">NIS : </span>
                                            <field name="nis"></field>
                                        </li>
                                        <li>
                                            <span class="text-muted">Tempat Lahir : </span>
                                            <field name="tmp_lahir"></field>
                                        </li>
                                        <li>
                                            <span class="text-muted">Tgl Lahir : </span>
                                            <field name="tgl_lahir"></field>
                                        </li>
                                        <li>
                                            <span class="text-muted">Nama Ayah : </span>
                                            <field name="ayah_nama"></field>
                                        </li>
                                        <li>
                                            <span class="text-muted">Nama Ibu : </span>
                                            <field name="ibu_nama"></field>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="action_update_nama_sekolah" model="ir.actions.server">
            <field name="name">Perbarui Sekolah Sesuai PSB</field>
            <field name="model_id" ref="model_cdn_siswa" />
            <field name="binding_model_id" ref="model_cdn_siswa" />
            <field name="state">code</field>
            <field name="code">
                model.update_nama_sekolah_all()
            </field>
        </record>
        <!-- action window -->
        <record id="action_cdn_siswa" model="ir.actions.act_window">
            <field name="name">Siswa</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cdn.siswa</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="views">[
                (ref('view_cdn_siswa_tree'), 'list'),
                (ref('view_cdn_siswa_form'), 'form')
                ]</field>
            <field name="search_view_id" ref="view_cdn_siswa_search"/>
            <field name="context">{
                'search_default_group_by_jenjang': 1,
                'search_default_group_by': 'jenjang',
                'form_view_ref': 'pesantren_base.view_cdn_siswa_form',
                }</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to add a new Siswa
                </p>
                <p>
                    Click the Create button to add a new Siswa
                </p>
            </field>
        </record>
        <menuitem id="menu_cdn_siswa" name="Siswa" parent="siswa_menu_categ"
            action="action_cdn_siswa" sequence="10" />

        <!-- List View Alumni (reuse tree view with extra columns) -->
        <record id="view_cdn_alumni_tree" model="ir.ui.view">
            <field name="name">cdn.alumni.list</field>
            <field name="model">cdn.siswa</field>
            <field name="type">list</field>
            <field name="priority" eval="12"/>
            <field name="arch" type="xml">
                <list string="Alumni Santri">
                    <field name="name"/>
                    <field name="namapanggilan" string="Panggilan"/>
                    <field name="nis"/>
                    <field name="jenjang"/>
                    <field name="nama_sekolah" string="Sekolah"/>
                    <field name="alasan_keluar" widget="badge"
                        decoration-success="alasan_keluar == 'lulus'"
                        decoration-warning="alasan_keluar in ('pindah','berhenti','lainnya')"
                        decoration-danger="alasan_keluar in ('dikeluarkan','meninggal')"/>
                    <field name="tanggal_keluar"/>
                </list>
            </field>
        </record>

        <!-- Search View Alumni -->
        <record id="view_cdn_alumni_search" model="ir.ui.view">
            <field name="name">cdn.alumni.search</field>
            <field name="model">cdn.siswa</field>
            <field name="type">search</field>
            <field name="priority" eval="12"/>
            <field name="arch" type="xml">
                <search string="Cari Alumni">
                    <field name="name" string="Nama"/>
                    <field name="nis"/>
                    <separator/>
                    <filter name="filter_lulus" string="Lulus" domain="[('alasan_keluar','=','lulus')]"/>
                    <filter name="filter_dikeluarkan" string="Dikeluarkan" domain="[('alasan_keluar','=','dikeluarkan')]"/>
                    <filter name="filter_pindah" string="Pindah" domain="[('alasan_keluar','=','pindah')]"/>
                    <filter name="filter_berhenti" string="Berhenti" domain="[('alasan_keluar','=','berhenti')]"/>
                    <filter name="filter_meninggal" string="Meninggal" domain="[('alasan_keluar','=','meninggal')]"/>
                    <filter name="filter_lainnya" string="Lainnya" domain="[('alasan_keluar','=','lainnya')]"/>
                    <separator/>
                    <group expand="0" string="Kelompokkan Berdasarkan">
                        <filter name="group_jenjang" string="Jenjang" context="{'group_by':'jenjang'}"/>
                        <filter name="group_alasan" string="Alasan Keluar" context="{'group_by':'alasan_keluar'}"/>
                        <filter name="group_tahun" string="Tahun Keluar" context="{'group_by':'tanggal_keluar:year'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for Alumni -->
        <record id="action_cdn_alumni" model="ir.actions.act_window">
            <field name="name">Alumni Santri</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cdn.siswa</field>
            <field name="view_mode">list,form</field>
            <field name="views">[(ref('view_cdn_alumni_tree'), 'list'), (ref('view_cdn_siswa_form'), 'form')]</field>
            <field name="domain">[('active', '=', False), ('alasan_keluar', '!=', False)]</field>
            <field name="context">{'active_test': False, 'search_default_group_alasan': 1}</field>
            <field name="search_view_id" ref="view_cdn_alumni_search"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Belum ada data alumni.
                </p>
                <p>
                    Santri yang dikeluarkan atau dinyatakan lulus melalui fitur Pemberhentian Santri akan muncul di sini.
                </p>
            </field>
        </record>

        <menuitem id="menu_cdn_alumni" name="Alumni" parent="siswa_menu_categ"
            action="action_cdn_alumni" sequence="20"/>
    </data>
</odoo>