<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data>
    <!-- cdn.master_rpm list view -->
    <record id="cdn_master_rpm_view_tree" model="ir.ui.view">
      <field name="name">cdn.master_rpm.view.list</field>
      <field name="model">cdn.master_rpm</field>
      <field name="arch" type="xml">
        <list>
          <!-- Add your fields here -->
          <field name="name" />
          <field name="jenjang" />
          <field name="matpel_id" />
          <field name="tingkat_id" />
          <field name="jurusan_id" />
          <field name="waktu" />
          <field name="kd" />
        </list>
      </field>
    </record>
    <!-- cdn.master_rpm form view -->
    <record id="cdn_master_rpm_view_form" model="ir.ui.view">
      <field name="name">cdn.master_rpm.view.form</field>
      <field name="model">cdn.master_rpm</field>
      <field name="arch" type="xml">
        <form string="">
          <sheet>
            <group>
              <!-- Add your fields here<field name="name"/> -->
              <field name="name" />
              <field name="jenjang" />
              <field name="matpel_id" domain="[('jenjang', '=', jenjang)]" />
              <field name="tingkat_id"
                domain="[('jenjang', '=', jenjang)]"
                options="{
                      'no_create_edit':True, 
                      'no_create':True, 
                      'no_open': True
                    }" />
              <field name="jurusan_id" invisible="jenjang not in ('sma')" />
              <field name="waktu" />
              <field name="kd" />
              <field name="dokumen" />
              <field name="tujuan" />
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- cdn.master_rpm action window -->
    <record id="cdn_master_rpm_action" model="ir.actions.act_window">
      <field name="name">Rencana Pembelajaran Mendalam</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">cdn.master_rpm</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">
          <!-- Add Text Here -->
        </p>
        <p>
          <!-- More details about what a user can do with this object will be OK -->
        </p>
      </field>
    </record>

    <!-- This Menu Item must have a parent and an action -->
    <menuitem id="master_rpm_menu_act" name="Master RPM" parent="pengaturan_menu_categ"
      action="cdn_master_rpm_action" sequence="10" />
  </data>
</odoo>
