<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pesantren_guru.PdfPreviewWidget" owl="1">
        <div class="o_pdf_preview_widget" style="width: 100%; display: block; position: relative;">
            <!-- Loading spinner overlay -->
            <div t-if="state.isLoading"
                 class="d-flex flex-column align-items-center justify-content-center bg-light border rounded"
                 style="min-height: 300px; width: 100%;">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <span class="fw-bold text-dark fs-5">Memuat Preview Dokumen PDF...</span>
                <span class="text-muted small mt-1">Mohon tunggu sebentar</span>
            </div>

            <!-- PDF viewer iframe -->
            <iframe t-if="viewerUrl"
                    t-att-src="viewerUrl"
                    t-att-style="'width: 100%; height: 800px; border: 1px solid #dee2e6; border-radius: 0.375rem;' + (state.isLoading ? ' position: absolute; left: -9999px;' : '')"
                    t-on-load="onIframeLoad"
                    t-on-error="onIframeError"
            />

            <!-- Error state -->
            <div t-if="!state.isLoading and state.hasError"
                 class="alert alert-warning text-center p-4 rounded mb-0"
                 style="width: 100%;">
                <i class="fa fa-exclamation-triangle fa-2x mb-2 d-block text-warning"/>
                <div class="fw-bold">Tidak dapat memuat preview PDF</div>
                <div class="small text-muted">Silakan unduh dokumen atau pastikan berkas berformat PDF yang valid.</div>
            </div>
        </div>
    </t>
</templates>
