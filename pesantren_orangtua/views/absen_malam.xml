<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Action untuk Absensi Malam (Orang Tua hanya lihat) -->
        <record id="cdn_absensi_malam_action_orangtua" model="ir.actions.act_window">
            <field name="name">Absensi Malam</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cdn.absensi_malam</field>
            <field name="view_mode">list,form</field>
            <!-- pakai view dari modul kesantrian -->
            <field name="view_id" ref="pesantren_kesantrian.cdn_absensi_malam_view_tree"/>
            <!-- filter data hanya untuk anak dari user yang login -->
            <field name="domain">
            [
                ('siswa_id.orangtua_id.partner_id.user_id','=',uid),
                ('state','=','done')
            ]
            </field>
        </record>

        <!-- Tree View link ke action -->
        <record id="action_tree_view_cdn_absensi_malam_orangtua" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="pesantren_kesantrian.cdn_absensi_malam_view_tree"/>
            <field name="act_window_id" ref="cdn_absensi_malam_action_orangtua"/>
        </record>

        <!-- Form View link ke action -->
        <record id="action_form_view_cdn_absensi_malam_orangtua" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="pesantren_kesantrian.cdn_absensi_malam_view_form"/>
            <field name="act_window_id" ref="cdn_absensi_malam_action_orangtua"/>
        </record>

        <!-- Menu di bawah menu Orang Tua > Kesantrian -->
        <menuitem id="cdn_absensi_malam_menu_orangtua"
                  name="Absensi Malam"
                  parent="kesantrian_menu_categ"
                  action="cdn_absensi_malam_action_orangtua"
                  sequence="15"/>
    </data>
</odoo>